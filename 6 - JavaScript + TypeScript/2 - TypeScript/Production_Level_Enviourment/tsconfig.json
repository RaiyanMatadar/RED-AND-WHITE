{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "strict": true,
    "noEmitOnError": true,
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,

    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
